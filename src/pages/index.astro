{title:'Selected work',year:'2025',image:base+'517e6678-04ac-4fa8-ae78-8396bb5e0140/LayingMeadowSpring_KatieKratzer_Copyright2025.png'},
{title:'Selected work',year:'2023',image:base+'44abd357-e44c-4bb4-9ec1-9769f5211be1/Pulling%2BAway%2BPulling%2BIn_KatieKratzer2023.jpg'}];
